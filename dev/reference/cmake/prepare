#!/usr/bin/env python3
"""Collects the CMake files that the lexer is checked on.

They are the CMake files in CMake's own source, random texts for
checking the lexer, and random scripts that call message() for checking
escapes and variable references. CASES sets how many random texts and
how many random scripts there are (5,000 each by default), and SEED
makes them different.

Usage: prepare <work>
"""

import os
import pathlib
import random
import shutil
import sys
import tarfile

work = pathlib.Path(sys.argv[1])
seed = int(os.environ.get("SEED") or 1)
# When the lexer was written, it was checked on 25,000 random texts and
# 15,000 random scripts.
texts = scripts = int(os.environ.get("CASES") or 5000)

source = work / "corpus" / "cmake"
if not source.exists():
    tmp = work / "corpus" / "cmake.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    with tarfile.open("/opt/cmake-src.tar.gz") as t:
        t.extractall(tmp, filter="data")
    (top,) = tmp.iterdir()
    top.rename(source)
    tmp.rmdir()

# Random texts for the lexer. Each line is usually a command whose
# arguments are glued together from pieces that are tricky for the lexer.
# Most texts should get far before CMake's parser gives up, because the
# check stops there.

ARG_PIECES = [
    "a", "b_1", "AND", "OR", "NOT", "STREQUAL", "DEFINED", "if", "x.y", "-", "=",
    "[", "]", "[[", "]]", "[=[", "]=]", "[==[", "]==]", "#", "#[[", "#[=[", "\"",
    "\\", "\\\\", "\\n", "\\;", "\\q", "\\\"", "\\#", "\\(", "\\ ", "\\é", "$",
    "${", "}", "$ENV{", "$CACHE{", "$<", ">", ":", ",", "$(x)", "$(", "(", ")",
    "é", "中", " ", "  ", "\t", "\r", "a\"b c\"", "=\"x\"", "[=\"y z\"", "@",
]


def arg_text(r):
    n = r.choices([0, 1, 2, 3, 4, 5, 6], [1, 4, 3, 2, 1, 1, 1])[0]
    return "".join(r.choice(ARG_PIECES) for _ in range(n))


def line(r):
    k = r.random()
    if k < 0.1:
        return "#" + arg_text(r)
    if k < 0.15:
        return arg_text(r)
    name = r.choice(["if", "IF", "elseif", "while", "set", "endif", "foo_1",
                     "message", "else", "x"])
    sp = r.choice(["", "", " ", "\t"])
    args = []
    for _ in range(r.randint(0, 4)):
        args.append(arg_text(r))
        args.append(r.choice([" ", " ", "\n", "\r\n", "\n  ", " # c\n"]))
    tail = r.choice(["", "", "", "", "", " # x", " foo()", " #[[z]]"])
    indent = r.choice(["", "", "", "  ", " #[[c]] "])
    return f"{indent}{name}{sp}({''.join(args)}){tail}"


def text(r):
    lines = [line(r) for _ in range(r.randint(1, 6))]
    t = "".join(l + r.choice(["\n", "\n", "\r\n"]) for l in lines)
    if r.random() < 0.3:
        t = t.rstrip("\n")
    return t


# Random scripts that print one quoted argument. CMake only reads escapes
# and variable references when it runs a command, so the compare script
# runs these with cmake -P.

PIECES = ["a", "B_1", "${", "${", "$ENV{", "$CACHE{", "}", "}", "\\;", "\\t",
          "\\n", "\\q", "\\0", "\\}", "\\$", "\\{", "\\ ", "\\\\", "$", "$<",
          ">", "/", ".", "+", "-", " ", "@", "x{", "$x{", ":", "é", "\\é", "#",
          "(", ")", ";", "\\é"]
# The compare script has the same prefix.
PREFIX = "cmake_policy(VERSION 3.31)\nmessage(\""


def script(r):
    t = "".join(r.choice(PIECES) for _ in range(r.randint(1, 8)))
    return PREFIX + t + "\")\n"


def write(kind, n, make):
    d = work / "random" / kind
    shutil.rmtree(d, ignore_errors=True)
    d.mkdir(parents=True)
    r = random.Random(f"{kind} {seed}")
    paths = []
    for i in range(n):
        p = d / f"{i}.cmake"
        p.write_bytes(make(r).encode())
        paths.append(p)
    return paths


paths = sorted(
    p for p in source.rglob("*")
    if p.is_file()
    and (p.name == "CMakeLists.txt" or p.name.endswith((".cmake", ".cmake.in")))
)
corpus = len(paths)
paths += write("texts", texts, text)
paths += write("scripts", scripts, script)
# The names of the random files don't tell tergi their language.
(work / "files.txt").write_text("".join(f"Cmake\t{p}\n" for p in paths))
print(f"{corpus} files from CMake, {texts} random texts, {scripts} random scripts")
