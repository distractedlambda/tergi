#!/bin/sh
# Copies the YAML files from the image into the work directory, where the
# dev image can read them, and lists them in files.txt.
#
# Usage: prepare <work>

set -eu
work=$1
rm -rf "$work/corpus"
cp -a /opt/corpus "$work/corpus"

# The test suite also lists each test under its name and tags, through
# links to its directory. find doesn't follow them, so each file comes
# once.
find "$work/corpus" -type f \( -name '*.yaml' -o -name '*.yml' \) | LC_ALL=C sort \
    | sed 's/^/Yaml\t/' > "$work/files.txt"
echo "$(wc -l < "$work/files.txt") files"
