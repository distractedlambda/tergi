#!/bin/sh
# Copies the Python files from the image into the work directory, where
# the dev image can read them, and lists them in files.txt.
#
# Usage: prepare <work>

set -eu
work=$1
rm -rf "$work/corpus"
# Not -a, which would keep the label that SELinux gives the image's files,
# so the dev image couldn't read the copy.
cp -R --preserve=mode,timestamps /opt/corpus "$work/corpus"
find "$work/corpus" -name '*.py' -type f | LC_ALL=C sort > "$work/files.txt"
echo "$(wc -l < "$work/files.txt") files"
