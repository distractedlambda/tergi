#!/usr/bin/env python3
"""Fetches the Python files that the lexer is checked on.

They are CPython's source, and the packages Django, NumPy, pandas,
requests and SymPy as pip downloads them. The Containerfile runs this,
so that the image holds them. Usage: fetch <directory>
"""

import hashlib
import io
import pathlib
import shutil
import subprocess
import sys
import tarfile
import urllib.request
import zipfile

CPYTHON = "https://www.python.org/ftp/python/3.15.2/Python-3.15.2.tgz"
CPYTHON_SHA256 = "f74e1db0eabd651cd01e4e2a00201bd41866abe74869ab716f9bf33cbbaa0943"
PACKAGES = [
    "django==6.1.3",
    "numpy==2.5.5",
    "pandas==3.1.1",
    "requests==2.34.2",
    "sympy==1.14.0",
]

corpus = pathlib.Path(sys.argv[1])
corpus.mkdir(parents=True)

data = urllib.request.urlopen(CPYTHON).read()
if hashlib.sha256(data).hexdigest() != CPYTHON_SHA256:
    sys.exit(f"{CPYTHON} doesn't have the expected SHA-256 sum")
with tarfile.open(fileobj=io.BytesIO(data)) as t:
    t.extractall(corpus / "cpython", filter="data")

# NumPy and pandas only have wheels for some platforms, but the Python
# files in them are the same on each.
wheels = corpus / "wheels"
subprocess.run(
    ["pip", "download", "--quiet", "--disable-pip-version-check",
     "--no-deps", "--only-binary", ":all:", "-d", wheels, *PACKAGES],
    check=True,
)
for whl in sorted(wheels.glob("*.whl")):
    with zipfile.ZipFile(whl) as z:
        z.extractall(corpus / "packages" / whl.stem)
shutil.rmtree(wheels)

# Only the Python files are checked, so the rest would only make the
# image bigger.
for p in sorted(corpus.rglob("*"), reverse=True):
    if p.is_symlink() or (p.is_file() and p.suffix != ".py"):
        p.unlink()
    elif p.is_dir() and not any(p.iterdir()):
        p.rmdir()
