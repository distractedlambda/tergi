# bash 5.3, patched by instrument.py so that it reports where the tokens
# it reads start and end. Its source also holds the tests and examples
# that the lexer is checked on, along with the shell scripts of git 2.47.1
# and bash-completion 2.14.0.
FROM docker.io/library/debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bison ca-certificates curl gcc libc6-dev \
        make python3 xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG BASH_SHA256=0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba
RUN curl -fsSL -o /opt/bash.tar.gz https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz \
    && echo "$BASH_SHA256  /opt/bash.tar.gz" | sha256sum -c -

ARG GIT_SHA256=f4c4e98667800585d218dfdf415eb72f73baa7abcac4569e2ce497970f8d6665
RUN curl -fsSL -o /opt/git.tar.gz \
        https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.47.1.tar.gz \
    && echo "$GIT_SHA256  /opt/git.tar.gz" | sha256sum -c -

ARG COMPLETION_SHA256=5c7494f968280832d6adb5aa19f745a56f1a79df311e59338c5efa6f7285e168
RUN curl -fsSL -o /opt/bash-completion.tar.xz \
        https://github.com/scop/bash-completion/releases/download/2.14.0/bash-completion-2.14.0.tar.xz \
    && echo "$COMPLETION_SHA256  /opt/bash-completion.tar.xz" | sha256sum -c -

# The patch changes parse.y, so the build runs bison again.
COPY instrument.py /build/
RUN tar xzf /opt/bash.tar.gz -C /build \
    && python3 /build/instrument.py /build/bash-5.3 \
    && cd /build/bash-5.3 \
    && { ./configure --without-bash-malloc --disable-nls && make -j"$(nproc)"; } \
        >/build/log 2>&1 || { tail -50 /build/log; exit 1; } \
    && cp /build/bash-5.3/bash /usr/local/bin/bash-tokens \
    && rm -rf /build
