# Zig 0.17.1, whose tokenizer src/highlight/zig.rs is checked against.
# The lib directory of the release is also the corpus.
FROM docker.io/library/debian:trixie-slim

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

# The sums come from https://ziglang.org/download/index.json.
RUN set -eu; \
    arch=$(uname -m); \
    case "$arch" in \
        x86_64) sum=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a ;; \
        aarch64) sum=a1546d5646eb184437918d6635ca6b762a0e889eac09cef720ee7a1ed3fe7795 ;; \
        *) echo "no Zig download for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/zig.tar.xz "https://ziglang.org/download/0.17.1/zig-$arch-linux-0.17.1.tar.xz"; \
    echo "$sum  /tmp/zig.tar.xz" | sha256sum -c -; \
    mkdir /opt/zig; \
    tar xf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; \
    rm /tmp/zig.tar.xz

# Zig builds for the CPU it runs on unless told otherwise. CI caches this
# image and reuses it on runners with other CPUs, where such a binary can
# die with an illegal instruction, so it builds for a baseline CPU.
COPY compare.zig /src/compare.zig
RUN cd /src \
    && ZIG_GLOBAL_CACHE_DIR=/tmp/zig-cache /opt/zig/zig build-exe compare.zig -O ReleaseFast \
       -mcpu=baseline -femit-bin=/usr/local/bin/zig-compare \
    && rm -rf /tmp/zig-cache /src/.zig-cache
