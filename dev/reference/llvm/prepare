#!/bin/sh
# Collects the input files: every .ll file in LLVM 23.1.6's test directory.
# The release only has a tarball of the whole llvm-project, so we download
# that and keep just those files. A second run reuses them.
#
# Usage: prepare <work>

set -eu
work=$1
version=23.1.6
sha256=d3b86ab29cfb4445a6652e5c2642ccc75e04e38084dde3701d323320f35a31da
name=llvm-project-$version.src
tests=$work/llvm-$version-test

if [ ! -d "$tests" ]; then
    tmp=$work/download
    rm -rf "$tmp"
    mkdir -p "$tmp"
    echo "Downloading $name.tar.xz"
    curl -fsSL -o "$tmp/$name.tar.xz" \
        "https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/$name.tar.xz"
    echo "$sha256  $tmp/$name.tar.xz" | sha256sum -c
    tar -xJf "$tmp/$name.tar.xz" -C "$tmp" --wildcards "$name/llvm/test/*.ll"
    mv "$tmp/$name/llvm/test" "$tests"
    rm -rf "$tmp"
fi

# The language name in front of each path keeps tergi from guessing it.
find "$tests" -name '*.ll' -type f | LC_ALL=C sort | sed 's/^/LlvmIr\t/' > "$work/files.txt"
echo "$(wc -l < "$work/files.txt") files"
