# An image for building and testing tergi. Build it from the `dev`
# directory, mount the project, and run cargo inside it. Mounting a volume
# at /usr/local/cargo/registry saves downloading crates on every run.
#
# The integration tests run at the same time, and each one starts git and
# tergi, so together they need more processes than podman allows a
# container by default (2048). Then about half of them fail, though each
# passes on its own. Run the container with `--pids-limit=-1`.
#
# Some tests need git 2.45 or newer, which can create repositories in the
# reftable format. Older versions skip those tests, so use a Debian release
# that ships a new enough git.

FROM docker.io/library/rust:1.100.0-slim-trixie

# tmux is for running the app by hand in a terminal we can script.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git tmux pkg-config locales \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen \
    && locale-gen
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

RUN rustup component add clippy rustfmt

# The tests make commits in scratch repositories.
RUN git config --system user.name "Test User" \
    && git config --system user.email "test@example.com" \
    && git config --system init.defaultBranch main
